; GDExtension del motor del Juego de Baile (engine/jd_godot, godot-rust/gdext). Agente G.
; Compilar: scripts/build_windows.ps1 o scripts/build_linux.sh (copian la biblioteca a game/bin/).
; Si la biblioteca no está, Godot avisa y ClassDB.class_exists("JDEngine") es false: el juego usa
; las simulaciones de game/core/mock_engine.gd.

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://bin/jd_godot.dll"
windows.release.x86_64 = "res://bin/jd_godot.dll"
linux.debug.x86_64 = "res://bin/libjd_godot.so"
linux.release.x86_64 = "res://bin/libjd_godot.so"
